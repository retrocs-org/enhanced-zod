# Build artifacts
*.o
/zod
/zod_map_editor

# CMake out-of-source build dir
/build/
CMakeCache.txt
CMakeFiles/

# Large redundant archives (assets/ is already unpacked; z.zip is a source snapshot)
*.rar
*.zip

# OS junk
.DS_Store
Thumbs.db
/build-sdl3/
build-san/
zod_diag.log
zod_path.log

# SoundFont for MIDI music: fetched by CMake (see CMakeLists.txt), not kept in git
/assets/soundfonts/*.sf2
/assets/soundfonts/*.sf3
/assets/soundfonts/GeneralUser-GS-LICENSE.txt
/build-app/

# copyrighted original-game videos: keep local, never commit
assets/videos/*
!assets/videos/README.md
!assets/videos/.gitkeep

# Local Windows cross-build and packaged artifacts
/build-windows/

# Zod cloud build outputs and local credentials/state
/build-web/
/server-agent/data/
/packaging/linux/secrets/
/build-linux-vm/

/.lima/

/build-linux/
/build-private-state/
/build-public-state/

# Locally imported original Z disc files and converted source media
/assets/original-z/
/tools/__pycache__/

/build-asset-tools/

# Additional recorded tracks and test sample generated by the disc importer
/assets/sounds/music_arctic.ogg
/assets/sounds/music_city.ogg
/assets/sounds/TEST.wav

# Self-contained asset importer build environments
/build-importer-venv/
/build-asset-helper/

# Reproducible original-disc media stays local after importing. Already-tracked
# compatibility artwork remains until its conversion recipes are available.
/assets/buildings/**/*.png
/assets/cursors/*.png
/assets/fonts/**/*.png
/assets/other/**/*.png
/assets/units/**/*.png
/assets/teams/*.png
/assets/planets/**/*.png
/assets/planets/*.bmp
/assets/planets_1-10-10/
/assets/sounds/*.wav
/assets/sounds/*.MID
/assets/sounds/*.ogg
/assets/sounds/*.mp3
/build-asset-cleanup/

# Local release artifacts, receipts and configuration
/outputs/
/work/
/release-config.json

# Source-only repositories: all game media, converted levels and third-party fonts
# remain local/imported. Documentation and license notices may be committed.
/assets/**
!/assets/**/
!/assets/**/*.md
!/assets/**/README.txt
!/assets/**/*LICENSE*.txt
!/assets/**/*OFL*.txt
/maps/**
!/maps/README.md
/tools/z_graphics_patches/
*.map
*.ttf
*.otf
*.sf2
*.sf3
*.iso
*.bin
*.cue
*.xcf
/zod-enhanced
/zod-enhanced.exe
/zod-ee
/zod-ee.exe
/public-web/assets/battlefield.png
/.my.cnf

# Python test/tool bytecode
__pycache__/
*.pyc

*.zreplay
*.zreplay.part
*.prefab

# Generated public TLS trust bundle; copied from the build OS, never committed.
/assets/portal-ca.crt

# Private per-host cloud credentials generated by zod-agent --login.
**/credentials/identity.json
**/credentials/identity.json.tmp-*
